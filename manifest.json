{
  "manifest_version": 2,
  "name": "ftnQuoter-ss",
  "version": "2.0.6",
  "author": "Claude Code (orig. by Sergey Poziturin)",
  "description": "FTN-style message quoter (like GoldEd) for modern Thunderbird",
  "browser_specific_settings": {
    "gecko": {
      "id": "ftnQuoter@ss",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "accountsRead",
    "compose",
    "messagesRead",
    "storage",
    "messagesModify"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
