{
  "manifest_version": 2,
  "name": "ftnQuoter",
  "version": "2.0.3",
  "author": "Claude Code (orig. by Sergey Poziturin)",
  "description": "FTN-style message quoter (like GoldEd) for modern Thunderbird",
  "applications": {
    "gecko": {
      "id": "ftnQuoter@ss",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "compose",
    "messagesRead",
    "accountsRead",
    "storage",
    "tabs",
    "messagesModify"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "compose_action": {
    "default_title": "ftnQuoter",
    "default_icon": "icons/icon-48.png"
  }
}
